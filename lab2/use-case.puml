@startuml
top to bottom direction

skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam actorFontSize 15
skinparam usecaseFontSize 15
skinparam usecase {
  BackgroundColor #F5FBFF
  BorderColor #315A78
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #315A78
  FontStyle bold
}
skinparam note {
  BackgroundColor #F0FFF9
  BorderColor #20B89A
  FontColor #145B4D
}

actor "Працівник" as Employee
actor "Менеджер магазину" as Manager
actor "Робітник складу" as Worker
actor "Адміністратор" as Admin

Manager --|> Employee
Worker --|> Employee
Admin --|> Employee

rectangle "Система обліку постачань\n(клієнт і сервер)" as System {
  usecase "Увійти в систему" as Login
  usecase "Створити постачання" as Create
  usecase "Зберегти постачання\nлокально" as SaveDraft
  usecase "Переглянути постачання" as ViewSupply
  usecase "Переглянути збережені\nпостачання" as CachedSupply
  usecase "Прийняти постачання" as Accept
  usecase "Переглянути залишки" as ViewStock
  usecase "Переглянути збережені\nзалишки" as CachedStock

  note right of Create
    Онлайн: перевірити дані,
    зберегти на сервері, тоді
    запитати сервіс сповіщень.
    Відмова сервісу не скасовує
    збережене постачання.
  end note

  note right of Accept
    Після підтвердження система
    оновлює залишки та завершує
    постачання.
  end note

  note right of ViewStock
    Успішно отримані дані про
    постачання й залишки система
    зберігає локально.
  end note
}

' Розташування use cases у стовпчик зменшує перетини ліній.
Login -[hidden]down- Create
Create -[hidden]down- SaveDraft
SaveDraft -[hidden]down- ViewSupply
ViewSupply -[hidden]down- CachedSupply
CachedSupply -[hidden]down- Accept
Accept -[hidden]down- ViewStock
ViewStock -[hidden]down- CachedStock

Employee -right- Login
Employee -right- CachedSupply
Employee -right- CachedStock

Worker -right- ViewSupply
Worker -right- ViewStock
Worker -right- Accept

Manager -right- Create
Admin -right- Create
Manager -right- SaveDraft
Admin -right- SaveDraft
Manager -right- ViewSupply
Admin -right- ViewSupply
Manager -right- ViewStock
Admin -right- ViewStock
Manager -right- Accept
Admin -right- Accept

Accept ..> ViewSupply : <<include>>
CachedSupply ..> ViewSupply : <<extend>>\n[немає зв'язку]
CachedStock ..> ViewStock : <<extend>>\n[немає зв'язку]

note bottom of System
  Система сповіщень є зовнішнім сервісом, але не актором.
  Запит і повтор запиту — кроки сценарію створення постачання.
  «Зберегти постачання локально» працює без сервера;
  воно не створює постачання на сервері.
end note

@enduml